<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4FAF9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="26dp">



        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🐾"
            android:textSize="44sp"
            android:gravity="center"
            android:layout_marginTop="15dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AppVet"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#174A45"
            android:gravity="center"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gestión veterinaria"
            android:textSize="15sp"
            android:textColor="#667C79"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="30dp" />



        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GESTIÓN DEL PACIENTE"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#2A7F78"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnDetalle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🐾  VER DETALLE DE MASCOTA"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2A7F78"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnForm"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="✚  REGISTRAR CITA / PACIENTE"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2A7F78"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnConfirmar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="✓  CONFIRMAR CITA"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2A7F78"
            android:layout_marginBottom="30dp" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SERVICIOS"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#2A7F78"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnMapa"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="📍  ABRIR UBICACIÓN EN MAPAS"
            android:textColor="#174A45"
            android:backgroundTint="#DCEFED"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnLlamar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="☎  LLAMAR A URGENCIAS"
            android:textColor="#174A45"
            android:backgroundTint="#DCEFED"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnCorreo"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="✉  ENVIAR CORREO DE CONSULTA"
            android:textColor="#174A45"
            android:backgroundTint="#DCEFED"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnFoto"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="📷  TOMAR FOTO DE MASCOTA"
            android:textColor="#174A45"
            android:backgroundTint="#DCEFED"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnCalendario"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="📅  AGREGAR VACUNA AL CALENDARIO"
            android:textColor="#174A45"
            android:backgroundTint="#DCEFED"
            android:layout_marginBottom="30dp" />



        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tener cuatro patas es solo un detalle; su lugar en la familia es irremplazable🐾"
            android:textSize="13sp"
            android:textColor="#667C79"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>